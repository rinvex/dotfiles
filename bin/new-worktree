#!/usr/bin/env bash
# new-worktree — fork a fully isolated, Herd-served worktree off a project.
#
#   new-worktree [new] <project_repo> <base_branch> <feature_name> [launch_cmd]
#   new-worktree ls                       (every worktree made by this tool)
#   new-worktree dev [name]               (node sites: run the dev server on the worktree's port, from inside it or by name)
#   new-worktree rm <name|path> [--force] (unlink/unproxy, drop the database, remove worktree + merged branch)
#   new-worktree inspect <path>          (show detected app dir and stack)
#
#   launch_cmd (optional): what to exec inside the worktree when done, e.g. "claude".
#   Default: a login shell.
#
#   Options (anywhere on the line):
#     --fresh     Laravel: migrate + seed an empty database instead of copying the project's data
#     --no-open   do not open the browser when done
set -euo pipefail

WORKTREES_ROOT="${WORKTREES_ROOT:-$HOME/Worktrees}"
TLD="${HERD_TLD:-test}"
OPT_FRESH=0
OPT_OPEN=1

# ── helpers ───────────────────────────────────────────────
say()  { printf '\033[1;34m▸\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m✔\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m✖\033[0m %s\n' "$*" >&2; exit 1; }
usage() { awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$0"; exit "${1:-1}"; }

slugify() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'; }

# ── project inspection ────────────────────────────────────
# app_dir: where the application actually lives inside a checkout.
# Handles repos whose app sits in a subfolder (site/, app/, web/ …).
# Only git-TRACKED markers count: an ignored subfolder (e.g. a nested repo)
# will not exist inside a fresh worktree.
tracked() { git -C "$1" ls-files --error-unmatch "$2" >/dev/null 2>&1; }
find_app_dir() {
  local root="$1" rel f
  for rel in "" site app web src; do
    for f in artisan package.json composer.json; do
      tracked "$root" "${rel:+$rel/}$f" && { printf '%s' "$root${rel:+/$rel}"; return; }
    done
  done
  # single tracked subfolder holding the app
  local candidates
  candidates=$(git -C "$root" ls-files 2>/dev/null | grep -E '^[^/]+/(artisan|package\.json)$' | sed 's#/[^/]*$##' | sort -u)
  if [ "$(printf '%s\n' "$candidates" | grep -c .)" -eq 1 ]; then printf '%s' "$root/$candidates"; return; fi
  printf '%s' "$root"
}

# stack: laravel | node | static
detect_stack() {
  local d="$1"
  if   [ -f "$d/artisan" ];        then echo laravel
  elif [ -f "$d/package.json" ];   then echo node
  else                                  echo static
  fi
}

# ── .env helpers ──────────────────────────────────────────
env_get() { sed -n -E "s/^$2=[\"']?([^\"']*)[\"']?\$/\1/p" "$1" | head -1; }
# env_set FILE KEY VALUE — replace in place, or append if the key is absent
env_set() {
  if grep -q "^$2=" "$1"; then sed -i '' -E "s|^$2=.*|$2=$3|" "$1"; else printf '%s=%s\n' "$2" "$3" >> "$1"; fi
}
# env_set_if_present FILE KEY VALUE — only rewrite keys the project actually uses
env_set_if_present() { grep -q "^$2=" "$1" && sed -i '' -E "s|^$2=.*|$2=$3|" "$1" || true; }

# ── laravel ───────────────────────────────────────────────
# laravel_env PROJECT_APP_DIR APP_DIR HOST DBNAME
laravel_env() {
  local src="$1/.env" dst="$2/.env" host="$3" dbname="$4"
  [ -f "$src" ] || { warn "no .env in project; copying .env.example"; src="$1/.env.example"; }
  [ -f "$src" ] || die "no .env or .env.example to start from"
  cp "$src" "$dst"
  env_set "$dst" APP_URL "https://$host.$TLD"
  env_set_if_present "$dst" APP_DOMAIN "$host.$TLD"
  env_set_if_present "$dst" ASSET_URL "https://$host.$TLD"
  env_set_if_present "$dst" VITE_APP_URL "https://$host.$TLD"
  env_set_if_present "$dst" SANCTUM_STATEFUL_DOMAINS "$host.$TLD"
  # namespace every shared stateful backend
  env_set "$dst" CACHE_PREFIX   "$dbname"
  env_set "$dst" REDIS_PREFIX   "${dbname}:"
  env_set "$dst" SESSION_COOKIE "${dbname}_session"
  # pin the cookie to this exact host so sibling *.PROJECT.test worktrees never share a session
  env_set "$dst" SESSION_DOMAIN "$host.$TLD"
  [ -z "$(env_get "$dst" APP_KEY)" ] && php artisan key:generate --force --quiet
  ok ".env namespaced"
}

# laravel_database PROJECT_APP_DIR APP_DIR DBNAME
# Gives the worktree its own database holding a copy of the project's data
# (or an empty migrated + seeded one with --fresh).
laravel_database() {
  local src_dir="$1" dir="$2" dbname="$3" env="$2/.env" driver
  driver="$(env_get "$env" DB_CONNECTION)"; [ -n "$driver" ] || driver="$(php -r 'echo config("database.default");' 2>/dev/null || echo sqlite)"
  case "$driver" in
    sqlite)
      local src_db db
      db="$(env_get "$env" DB_DATABASE)"
      if [ -z "$db" ]; then
        db="$dir/database/database.sqlite"; src_db="$src_dir/database/database.sqlite"
      elif [ "${db#/}" != "$db" ]; then                 # absolute path
        case "$db" in "$src_dir"/*) src_db="$db"; db="$dir${db#"$src_dir"}"; env_set "$env" DB_DATABASE "$db" ;;
                       *) die "DB_DATABASE points outside the project ($db); refusing to share a sqlite file between worktrees" ;; esac
      else                                              # relative to the app dir
        src_db="$src_dir/$db"; db="$dir/$db"
      fi
      mkdir -p "$(dirname "$db")"
      if [ "$OPT_FRESH" = 1 ] || [ ! -f "$src_db" ]; then
        : > "$db"; php artisan migrate --force --seed --no-interaction
        ok "sqlite database created fresh: ${db#"$dir"/}"
      else
        cp -c "$src_db" "$db" 2>/dev/null || cp "$src_db" "$db"
        php artisan migrate --force --no-interaction
        ok "sqlite database cloned from project: ${db#"$dir"/}"
      fi
      ;;
    mysql|mariadb)
      local h P u pw src_db
      h="$(env_get "$env" DB_HOST)"; P="$(env_get "$env" DB_PORT)"; u="$(env_get "$env" DB_USERNAME)"; pw="$(env_get "$env" DB_PASSWORD)"
      src_db="$(env_get "$src_dir/.env" DB_DATABASE)"
      local mysql_args=(-h"${h:-127.0.0.1}" -P"${P:-3306}" -u"${u:-root}"); [ -n "$pw" ] && mysql_args+=(-p"$pw")
      env_set "$env" DB_DATABASE "$dbname"
      mysql "${mysql_args[@]}" -e "CREATE DATABASE IF NOT EXISTS \`$dbname\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci"
      if [ "$OPT_FRESH" = 1 ] || [ -z "$src_db" ] || ! mysql "${mysql_args[@]}" -e "USE \`$src_db\`" 2>/dev/null; then
        php artisan migrate --force --seed --no-interaction
        ok "$driver database created fresh: $dbname"
      else
        mysqldump "${mysql_args[@]}" --single-transaction --quick --routines --triggers --set-gtid-purged=OFF "$src_db" 2>/dev/null \
          | mysql "${mysql_args[@]}" "$dbname"
        php artisan migrate --force --no-interaction
        ok "$driver database cloned from $src_db: $dbname"
      fi
      ;;
    pgsql)
      local h P u pw src_db
      h="$(env_get "$env" DB_HOST)"; P="$(env_get "$env" DB_PORT)"; u="$(env_get "$env" DB_USERNAME)"; pw="$(env_get "$env" DB_PASSWORD)"
      src_db="$(env_get "$src_dir/.env" DB_DATABASE)"
      env_set "$env" DB_DATABASE "$dbname"
      export PGPASSWORD="$pw"
      if [ "$OPT_FRESH" = 1 ] || [ -z "$src_db" ]; then
        psql -h"${h:-127.0.0.1}" -p"${P:-5432}" -U"${u:-postgres}" -d postgres -c "CREATE DATABASE \"$dbname\""
        php artisan migrate --force --seed --no-interaction
        ok "pgsql database created fresh: $dbname"
      else
        # TEMPLATE copy is instant but needs no open connections on the source
        psql -h"${h:-127.0.0.1}" -p"${P:-5432}" -U"${u:-postgres}" -d postgres -c "CREATE DATABASE \"$dbname\" TEMPLATE \"$src_db\"" \
          || die "could not clone $src_db (close open connections to it, or use --fresh)"
        php artisan migrate --force --no-interaction
        ok "pgsql database cloned from $src_db: $dbname"
      fi
      unset PGPASSWORD
      ;;
    *) warn "unknown DB_CONNECTION '$driver'; database left untouched" ;;
  esac
}

# ── dependencies ──────────────────────────────────────────
# node_pm APP_DIR — package manager implied by the lockfile
node_pm() {
  if   [ -f "$1/pnpm-lock.yaml" ]; then echo pnpm
  elif [ -f "$1/yarn.lock" ];      then echo yarn
  elif [ -f "$1/bun.lock" ] || [ -f "$1/bun.lockb" ]; then echo bun
  else echo npm; fi
}

# install_deps PROJECT_APP_DIR APP_DIR
# Instant APFS clone of the project's vendor/ and node_modules/, then a
# lockfile-respecting install so the tree matches THIS branch.
install_deps() {
  local src="$1" dir="$2"
  if [ -f "$dir/composer.json" ]; then
    [ -d "$src/vendor" ] && [ ! -d "$dir/vendor" ] && { cp -c -R "$src/vendor" "$dir/vendor" 2>/dev/null || true; }
    (cd "$dir" && composer install --no-interaction --quiet) || die "composer install failed"
    ok "composer dependencies ready"
  fi
  if [ -f "$dir/package.json" ]; then
    local pm; pm="$(node_pm "$dir")"
    command -v "$pm" >/dev/null || die "$pm not found (the lockfile in this project implies it)"
    [ -d "$src/node_modules" ] && [ ! -d "$dir/node_modules" ] && { cp -c -R "$src/node_modules" "$dir/node_modules" 2>/dev/null || true; }
    ( cd "$dir" && case "$pm" in
        npm)  npm install --no-audit --no-fund --prefer-offline --silent ;;
        pnpm) pnpm install --frozen-lockfile --silent ;;
        yarn) yarn install --frozen-lockfile --silent ;;
        bun)  bun install --frozen-lockfile ;;
      esac ) || die "$pm install failed"
    # npm rewrites the lock's root "name" from the folder name when package.json has none — drop that noise
    local lock="$dir/package-lock.json"
    if [ -f "$lock" ] && ! git -C "$dir" diff --quiet -- package-lock.json 2>/dev/null; then
      if [ -z "$(git -C "$dir" diff -- package-lock.json | grep -E '^[-+] ' | grep -v '"name":')" ]; then
        git -C "$dir" checkout -- package-lock.json
      else
        warn "package-lock.json changed during install: the project's lockfile is out of sync with package.json"
      fi
    fi
    ok "$pm dependencies ready"
  fi
}

# build_assets APP_DIR STACK — Laravel/Vite sites need a build to serve without a dev server
build_assets() {
  local dir="$1" stack="$2"
  [ "$stack" = laravel ] && [ -f "$dir/package.json" ] || return 0
  grep -q '"build"' "$dir/package.json" || return 0
  local pm; pm="$(node_pm "$dir")"
  local log; log="$(mktemp -t new-worktree-build)"
  if (cd "$dir" && case "$pm" in npm) npm run build --silent ;; *) "$pm" run build ;; esac >"$log" 2>&1); then
    rm -f "$log"; ok "assets built"
  else
    cat "$log" >&2; rm -f "$log"; die "asset build failed"
  fi
}

# clone_storage PROJECT_APP_DIR APP_DIR — uploads, slides, generated files: an instant
# copy-on-write clone so the worktree sees the same files without sharing them
clone_storage() {
  local src="$1/storage/app" dst="$2/storage/app"
  [ -d "$src" ] || return 0
  mkdir -p "$dst"
  if cp -c -R "$src/." "$dst/" 2>/dev/null; then ok "storage/app cloned (copy-on-write)"
  else warn "storage/app could not be cloned; worktree starts with empty storage"; fi
}

# ── registry ──────────────────────────────────────────────
# One line per worktree, tab-separated:
#   path  project_repo  branch  stack  host  port  database
REGISTRY="$WORKTREES_ROOT/.registry.tsv"
# empty fields are stored as "-" (consecutive tabs would collapse when read back)
registry_add()    { mkdir -p "$WORKTREES_ROOT"; local f out=""; for f in "$@"; do out="$out${out:+	}${f:--}"; done; printf '%s\n' "$out" >> "$REGISTRY"; }
nz() { [ "$1" = - ] && printf '' || printf '%s' "$1"; }
registry_remove() { [ -f "$REGISTRY" ] && { grep -v "^$1	" "$REGISTRY" > "$REGISTRY.tmp" || true; mv "$REGISTRY.tmp" "$REGISTRY"; }; }
# registry_find NAME_OR_PATH — matches path, worktree folder name, host or branch
registry_find() {
  [ -f "$REGISTRY" ] || return 1
  awk -F'\t' -v q="$1" '$1==q || $1 ~ ("/" q "$") || $5==q || $3==q || $3=="feature/" q {print; exit}' "$REGISTRY" | grep .
}

# pick_port HOST — stable port derived from the host name, skipping ports in use
pick_port() {
  local n port
  n=$(printf '%s' "$1" | cksum | awk '{print $1}')
  port=$(( 4400 + n % 500 ))
  while lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1 || { [ -f "$REGISTRY" ] && cut -f6 "$REGISTRY" | grep -qx "$port"; }; do
    port=$(( port + 1 )); [ "$port" -gt 4999 ] && port=4400
  done
  printf '%s' "$port"
}

# node_serve APP_DIR HOST PORT — HTTPS proxy in Herd → the worktree's dev server
node_serve() {
  local dir="$1" host="$2" port="$3" pm; pm="$(node_pm "$dir")"
  herd proxy "$host" "http://127.0.0.1:$port" --secure >/dev/null
  ok "https://$host.$TLD  →  127.0.0.1:$port  (start it with: new-worktree dev)"
}

# ── new ───────────────────────────────────────────────────
cmd_new() {
  local args=() a
  for a in "$@"; do case "$a" in
    --fresh)   OPT_FRESH=1 ;;
    --no-open) OPT_OPEN=0 ;;
    --*)       die "unknown option: $a" ;;
    *)         args+=("$a") ;;
  esac; done
  set -- "${args[@]+"${args[@]}"}"
  [ $# -ge 3 ] || usage
  local project_repo base_branch new_feature launch_cmd
  project_repo="$(cd "$1" 2>/dev/null && pwd -P)" || die "project path not found: $1"
  # any path inside a repo means that repo
  project_repo="$(git -C "$project_repo" rev-parse --show-toplevel 2>/dev/null)" || die "not a git repository: $1"
  base_branch="$2"
  new_feature="$3"
  launch_cmd="${4:-}"

  command -v git  >/dev/null || die "git not found"
  git -C "$project_repo" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not a git repository: $project_repo"
  git -C "$project_repo" rev-parse --verify --quiet "refs/heads/$base_branch" >/dev/null \
    || git -C "$project_repo" rev-parse --verify --quiet "refs/remotes/origin/$base_branch" >/dev/null \
    || die "base branch not found: $base_branch"

  # derived from the blueprint (project side)
  local project_category project_name
  project_category="$(basename "$(dirname "$project_repo")")"   # rinvex
  project_name="$(basename "$project_repo")"                    # awqaf

  # derived for the worktree side
  local worktree_name worktree_branch worktree_path worktree_host
  worktree_name="$(slugify "$new_feature")"
  [ -n "$worktree_name" ] || die "feature name produced an empty slug: '$new_feature'"
  worktree_branch="feature/$worktree_name"
  worktree_path="$WORKTREES_ROOT/$project_category/$project_name/$worktree_name"
  worktree_host="$worktree_name.$project_name"

  [ -e "$worktree_path" ] && die "worktree path already exists: $worktree_path"
  git -C "$project_repo" rev-parse --verify --quiet "refs/heads/$worktree_branch" >/dev/null \
    && die "branch already exists: $worktree_branch (use another feature name, or delete it first)"

  local app_rel app_dir stack
  app_rel="$(find_app_dir "$project_repo")"; app_rel="${app_rel#"$project_repo"}"; app_rel="${app_rel#/}"
  app_dir="$worktree_path${app_rel:+/$app_rel}"
  stack="$(detect_stack "$project_repo${app_rel:+/$app_rel}")"

  say "project  $project_repo  ($stack${app_rel:+, app in $app_rel/})"
  say "worktree $worktree_path  branch $worktree_branch  off $base_branch"

  # 1. worktree: new branch off the blueprint's base branch
  mkdir -p "$(dirname "$worktree_path")"
  git -C "$project_repo" worktree add "$worktree_path" -b "$worktree_branch" "$base_branch"
  ok "worktree created"

  cd "$app_dir"

  # 2. env: copy blueprint, then NAMESPACE every stateful backend (this is what isolates it)
  local project_app_dir="$project_repo${app_rel:+/$app_rel}" worktree_database
  worktree_database="wt_$(printf '%s' "${project_name}_${worktree_name}" | tr '.-' '__')"
  if [ "$stack" = laravel ]; then
    laravel_env "$project_app_dir" "$app_dir" "$worktree_host" "$worktree_database"
  else
    local f; for f in .env .dev.vars; do [ -f "$project_app_dir/$f" ] && { cp "$project_app_dir/$f" "$f"; ok "$f copied"; }; done
  fi

  # 3. deps: instant APFS clone → reconcile against the branch's lockfile
  install_deps "$project_app_dir" "$app_dir"

  # 4. isolated database
  if [ "$stack" = laravel ]; then
    laravel_database "$project_app_dir" "$app_dir" "$worktree_database"
  fi

  # 5. assets
  build_assets "$app_dir" "$stack"

  # 6. runtime + serve
  local port=""
  case "$stack" in
    laravel)
      clone_storage "$project_app_dir" "$app_dir"
      php artisan storage:link 2>/dev/null || true
      herd link "$worktree_host" >/dev/null
      herd secure "$worktree_host" >/dev/null 2>&1 || true
      ok "$worktree_branch  →  https://$worktree_host.$TLD  (db: $worktree_database)"
      [ "$OPT_OPEN" = 1 ] && { open "https://$worktree_host.$TLD" 2>/dev/null || true; }
      ;;
    node)
      port="$(pick_port "$worktree_host")"
      node_serve "$app_dir" "$worktree_host" "$port"
      worktree_database=""
      ;;
    *)
      worktree_database=""
      ok "$worktree_branch ready (nothing to serve)"
      ;;
  esac
  registry_add "$worktree_path" "$project_repo" "$worktree_branch" "$stack" "$worktree_host" "$port" "$worktree_database"

  # hand off inside the worktree: run launch_cmd if given (e.g. claude), else a login shell
  cd "$app_dir"
  if [ -n "$launch_cmd" ]; then
    exec $launch_cmd
  else
    exec "$SHELL" -l
  fi
}

# ── dev ───────────────────────────────────────────────────
# Resolve the registry line for a name, a path, or the current directory.
resolve_entry() {
  local q="${1:-}" entry=""
  if [ -n "$q" ]; then entry="$(registry_find "$q" || true)"; [ -z "$entry" ] && [ -d "$q" ] && entry="$(registry_find "$(cd "$q" && pwd -P)" || true)"
  else
    local d; d="$(pwd -P)"
    while [ "$d" != / ]; do entry="$(registry_find "$d" || true)"; [ -n "$entry" ] && break; d="$(dirname "$d")"; done
  fi
  [ -n "$entry" ] || return 1
  printf '%s' "$entry"
}

cmd_dev() {
  local entry; entry="$(resolve_entry "${1:-}")" || die "not a registered worktree: ${1:-$(pwd)} (see: new-worktree ls)"
  local path stack host port; IFS=$'\t' read -r path _ _ stack host port _ <<< "$entry"; port="$(nz "$port")"
  [ "$stack" = node ] || die "'dev' is for node sites; this is a $stack worktree served by Herd at https://$host.$TLD"
  local dir; dir="$(find_app_dir "$path")"; local pm; pm="$(node_pm "$dir")"
  say "https://$host.$TLD  →  127.0.0.1:$port"
  cd "$dir"
  # Vite refuses unknown Host headers; this env var whitelists the proxy host without touching config
  export __VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS="$host.$TLD"
  exec "$pm" run dev -- --port "$port" --host 127.0.0.1
}

# ── ls ────────────────────────────────────────────────────
cmd_ls() {
  [ -s "$REGISTRY" ] || { echo "no worktrees (root: $WORKTREES_ROOT)"; return 0; }
  { printf 'NAME\tBRANCH\tSTACK\tURL\tPATH\n'
    while IFS=$'\t' read -r path _ branch stack host port db; do
      port="$(nz "$port")"; local st=""; [ -d "$path" ] || st=" (missing!)"
      printf '%s\t%s\t%s\t%s\t%s%s\n' "$(basename "$path")" "$branch" "$stack" "https://$host.$TLD${port:+ →:$port}" "$path" "$st"
    done < "$REGISTRY"; } | column -t -s $'\t'
}

# ── rm ────────────────────────────────────────────────────
cmd_rm() {
  local force=0 args=() a
  for a in "$@"; do case "$a" in --force|-f) force=1 ;; --*) die "unknown option: $a" ;; *) args+=("$a") ;; esac; done
  [ ${#args[@]} -ge 1 ] || usage
  local entry; entry="$(resolve_entry "${args[0]}")" || die "not a registered worktree: ${args[0]} (see: new-worktree ls)"
  local path repo branch stack host port db; IFS=$'\t' read -r path repo branch stack host port db <<< "$entry"
  port="$(nz "$port")"; db="$(nz "$db")"
  say "removing $path  ($branch)"

  # refuse to throw away work unless forced
  if [ -d "$path" ] && [ "$force" = 0 ] && [ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ]; then
    git -C "$path" status --short | head -20
    die "worktree has uncommitted changes; commit them or re-run with --force"
  fi

  # 1. stop serving
  case "$stack" in
    laravel) herd unsecure "$host" >/dev/null 2>&1 || true; herd unlink "$host" >/dev/null 2>&1 || true; ok "herd link removed" ;;
    node)    herd unproxy "$host" >/dev/null 2>&1 || true; ok "herd proxy removed" ;;
  esac

  # 2. drop the database (server-side ones; sqlite files go with the folder)
  if [ -n "$db" ] && [ -f "$path/.env" ] || [ -n "$db" ] && [ -f "$(find_app_dir "$path" 2>/dev/null)/.env" ]; then
    local env; env="$(find_app_dir "$path")/.env"
    local driver h P u pw; driver="$(env_get "$env" DB_CONNECTION)"
    h="$(env_get "$env" DB_HOST)"; P="$(env_get "$env" DB_PORT)"; u="$(env_get "$env" DB_USERNAME)"; pw="$(env_get "$env" DB_PASSWORD)"
    case "$driver" in
      mysql|mariadb) local margs=(-h"${h:-127.0.0.1}" -P"${P:-3306}" -u"${u:-root}"); [ -n "$pw" ] && margs+=(-p"$pw")
                     mysql "${margs[@]}" -e "DROP DATABASE IF EXISTS \`$db\`" && ok "database $db dropped" ;;
      pgsql)         PGPASSWORD="$pw" psql -h"${h:-127.0.0.1}" -p"${P:-5432}" -U"${u:-postgres}" -d postgres -c "DROP DATABASE IF EXISTS \"$db\"" >/dev/null && ok "database $db dropped" ;;
    esac
  fi

  # 3. the worktree itself
  if [ -d "$path" ]; then
    git -C "$repo" worktree remove ${force:+--force} "$path" 2>/dev/null || git -C "$repo" worktree remove --force "$path"
  fi
  git -C "$repo" worktree prune
  ok "worktree removed"

  # 4. the branch: only if fully merged somewhere; otherwise keep it and say so
  if git -C "$repo" rev-parse --verify --quiet "refs/heads/$branch" >/dev/null; then
    if git -C "$repo" branch -d "$branch" >/dev/null 2>&1; then ok "branch $branch deleted (was merged)"
    elif [ "$force" = 1 ]; then git -C "$repo" branch -D "$branch" >/dev/null && warn "branch $branch force-deleted"
    else warn "branch $branch kept: it has unmerged commits (delete with: git -C $repo branch -D $branch)"; fi
  fi

  registry_remove "$path"
  # tidy empty parents
  rmdir "$(dirname "$path")" "$(dirname "$(dirname "$path")")" 2>/dev/null || true
}

# ── dispatch ──────────────────────────────────────────────
# `NEW_WORKTREE_LIB=1 source new-worktree` loads the functions without running anything (tests)
[ "${NEW_WORKTREE_LIB:-}" = 1 ] && return 0 2>/dev/null
case "${1:-}" in
  -h|--help|help|"") usage 0 ;;
  new) shift; cmd_new "$@" ;;
  ls)  cmd_ls ;;
  dev) shift; cmd_dev "$@" ;;
  rm)  shift; cmd_rm "$@" ;;
  inspect) shift; d="$(cd "$1" && pwd -P)"; a="$(find_app_dir "$d")"; printf '%s\t%s\t%s\n' "$d" "${a#"$d"}" "$(detect_stack "$a")" ;;
  *)   cmd_new "$@" ;;
esac
